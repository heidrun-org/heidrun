watch(
() => [currentGit.value?.root, currentGit.value?.changed, currentGit.value?.untracked],
([root], previous) => {
if (typeof root !== "string") {
return;
}
const isAnotherRepository = previous === undefined || previous[0] !== root;
void loadTree(root).then(() => {
