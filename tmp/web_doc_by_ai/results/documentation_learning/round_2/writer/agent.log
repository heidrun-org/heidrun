const dir = (p: string) => (p.includes("/") ? p.slice(0, p.lastIndexOf("/") + 1) : "");
const base = (p: string) => p.slice(p.lastIndexOf("/") + 1);
const open = (url?: string | null) => url && openUrl(url).catch(() => {});
</script>
