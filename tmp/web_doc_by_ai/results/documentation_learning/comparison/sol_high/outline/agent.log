import { defineConfig } from 'vitepress';
import identity from '../../../../../data/identity.json';
const base = '/heidrun/';
export default defineConfig({
title: identity.title,
description: identity.description.en,
head: [
['link', {
rel: 'icon',
type: 'image/svg+xml',
href: `${base}favicon.svg`,
}],
