});
it("tells the developer when the workspace is not a Git repository", () => {
state.selectedWorkspaceId = "w1";
git.status = { w1: null };
const wrapper = mount(FilesPanel);
expect(wrapper.text()).toBe("This workspace is not a Git repository.");
});
});
