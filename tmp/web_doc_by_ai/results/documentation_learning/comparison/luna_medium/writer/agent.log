} finally {
ed.saving = false;
}
}
async function markConflict(path: string) {
const ed = files.edits[path];
if (!ed) return;
ed.conflict = true;
try {
const st = await invoke<{ hash: string | null }>("file_stat", { root: files.root, path });
if (st.hash === null) {
ed.disk = null;
ed.diskHash = null;
return;
}
const r = await invoke<FileText>("file_read", { root: files.root, path });
