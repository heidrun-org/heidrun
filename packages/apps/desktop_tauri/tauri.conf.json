{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heidrun",
  "version": "0.2.0",
  "identifier": "dev.edefiez.herdrdesk",
  "build": {
    "beforeDevCommand": "pnpm --filter web_frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter web_frontend build",
    "frontendDist": "../web_frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heidrun",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B0C0E",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
