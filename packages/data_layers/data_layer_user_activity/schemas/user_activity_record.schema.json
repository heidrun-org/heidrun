{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserActivityRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceFolder", "startedAt", "lastActionAt", "endedAt", "keyboardActionCount", "mouseActionCount", "endReason"
  ],
  "properties": {
    "workspaceFolder": {
      "type": "string",
      "description": "Folder of the workspace: its worktree path, or the working directory of one of its panes."
    },
    "startedAt": { "type": "string", "format": "date-time", "description": "Time of the first action. UTC." },
    "lastActionAt": { "type": "string", "format": "date-time", "description": "Time of the last action. UTC." },
    "endedAt": { "type": "string", "format": "date-time", "description": "End of the active period. UTC." },
    "keyboardActionCount": { "type": "integer", "minimum": 0 },
    "mouseActionCount": { "type": "integer", "minimum": 0 },
    "endReason": { "enum": ["cool_down", "window_behind", "workspace_changed", "app_closed"] }
  }
}
