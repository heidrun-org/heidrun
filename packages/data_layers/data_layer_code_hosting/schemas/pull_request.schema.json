{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PullRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number", "title", "body", "state", "isDraft", "author", "mergedBy", "labels",
    "baseRefName", "headRefName", "mergeCommit", "createdAt", "updatedAt", "closedAt", "mergedAt",
    "additions", "deletions", "changedFiles", "commitCount"
  ],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "state": { "enum": ["OPEN", "CLOSED", "MERGED"] },
    "isDraft": { "type": "boolean" },
    "author": { "type": ["string", "null"], "description": "Login of the author. Null when the account is deleted." },
    "mergedBy": { "type": ["string", "null"], "description": "Login. Null when not merged." },
    "labels": { "type": "array", "items": { "type": "string" }, "description": "Names." },
    "baseRefName": { "type": "string" },
    "headRefName": { "type": "string" },
    "mergeCommit": { "type": ["string", "null"], "description": "Commit identifier. Null when not merged." },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "closedAt": { "type": ["string", "null"], "format": "date-time" },
    "mergedAt": { "type": ["string", "null"], "format": "date-time" },
    "additions": { "type": "integer", "minimum": 0 },
    "deletions": { "type": "integer", "minimum": 0 },
    "changedFiles": { "type": "integer", "minimum": 0 },
    "commitCount": { "type": "integer", "minimum": 0 }
  }
}
