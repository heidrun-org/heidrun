  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter desktop-tauri tauri dev",
    "build": "pnpm --filter desktop-tauri tauri build",
    "dev:web": "pnpm --filter web-frontend dev",
    "build:web": "pnpm --filter web-frontend build",
    "tauri": "pnpm --filter desktop-tauri tauri",
    "test": "pnpm --filter web-frontend test && pnpm --filter desktop-tauri test && pnpm --filter website_public test",
    "docs:shortcuts": "node scripts/shortcuts-readme.mjs",
    "release:dmg": "tsx scripts/release_dmg.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  }
}
