###############################################################################
###############################################################################
# Heidrun: example of the file .env
#
# The file .env holds the environment variables that you want while you work on
# Heidrun. This file, .env.example, lists every environment variable that the
# application reads, and explains each one.
#
# How to use it:
#   1. Copy this file to a file named .env at the root of the repository:
#        cp .env.example .env
#   2. In .env, remove the "#" at the start of each variable line that you want.
#   3. Start the application again with: pnpm dev
#
# Rules:
#   - Git ignores the file .env, so your values stay on your computer.
#   - Only a development build reads the file .env. A release build never reads
#     it.
#   - The application looks for .env in the current folder, then in each parent
#     folder. A worktree that has no .env of its own uses the .env of the main
#     checkout.
#   - A variable that is already set in your shell keeps the value of the shell.
#   - The application reads the file once, at the start. After a change, start
#     the application again.
#   - A value is plain text. The program does not expand "~" or "$HOME", so
#     write the full path of a folder.
#   - Every variable in this file stays commented out, so a copy of this file
#     changes nothing until you remove a "#".
#   - When you add code that reads an environment variable, add the variable to
#     this file in the same change. The test of the file environment_file.rs
#     fails when this file and the code do not list the same variables.
###############################################################################
###############################################################################


###############################################################################
# Variables of Heidrun
###############################################################################


###############################################################################
# HEIDRUN_DIR
#
# The folder where Heidrun keeps its own data files: the cache of the chats,
# the history of the work, the settings of the mobile access, and the records
# of the user activity.
#
# Use another folder to try Heidrun without touching your real data. The files
# of the status line of Claude Code do not follow this variable: they stay in
# ~/.config/heidrun.
#
# Default: ~/.config/heidrun
# Value: the full path of a folder.
###############################################################################
# HEIDRUN_DIR=/tmp/heidrun_data


###############################################################################
# HEIDRUN_MOBILE_BIND
#
# The network address where the server of the mobile access listens. It is for
# tests on this Mac only.
#
# Without this variable, Heidrun uses the Tailscale address of this Mac, the one
# that starts with 100. When Tailscale is not connected, the mobile access waits
# and tries again every few seconds.
#
# Any value that is not a Tailscale address or a loopback address is refused,
# for example 0.0.0.0. Heidrun then has no address, and the mobile access does
# not start.
#
# Default: the Tailscale address of this Mac
# Value: an IPv4 address in the range 100.64.0.0/10, or a loopback address that
#        starts with 127.
###############################################################################
# HEIDRUN_MOBILE_BIND=127.0.0.1


###############################################################################
# HEIDRUN_STATUS_ITEM_DEMO
#
# The status item of the macOS menu bar shows fake agents: two that are
# blocked, one that is finished, and three that are working. The data of the
# window is ignored. Use it to look at the animations of the status item.
#
# Default: not set, the status item shows the real agents.
# Value: any value switches it on, even an empty one. To switch it off, put the
#        "#" back.
###############################################################################
# HEIDRUN_STATUS_ITEM_DEMO=1


###############################################################################
# HEIDRUN_STATUS_ITEM_USER_ACTIVITY
#
# The icon of Heidrun in the macOS menu bar fades while you are not active in
# front of Heidrun, and is normal while you are active. You are active when the
# Heidrun window is in front and a keyboard action or a mouse action happened
# less than 5 seconds ago. Use it to check by eye that the detection of the user
# activity works. See https://github.com/heidrun-org/heidrun/issues/440
#
# Default: not set, the icon never fades.
# Value: any value switches it on, even an empty one. To switch it off, put the
#        "#" back.
###############################################################################
# HEIDRUN_STATUS_ITEM_USER_ACTIVITY=1


###############################################################################
# Variables of other programs that Heidrun reads
###############################################################################


###############################################################################
# CLAUDE_CONFIG_DIR
#
# The folder where Claude Code keeps its settings, its plugins, and its chats.
# Heidrun reads the chats and the plugins there, and writes the status line in
# the file settings.json there. An empty value is the same as no value.
#
# Default: ~/.claude
# Value: the full path of a folder.
###############################################################################
# CLAUDE_CONFIG_DIR=/tmp/claude_config


###############################################################################
# CODEX_HOME
#
# The folder where Codex keeps its sessions. Heidrun reads the chats and the
# usage of Codex there. An empty value is the same as no value.
#
# Default: ~/.codex
# Value: the full path of a folder.
###############################################################################
# CODEX_HOME=/tmp/codex_home


###############################################################################
# HERDR_SESSION
#
# The name of the Herdr session that Heidrun uses. Without this variable and
# without HERDR_SOCKET_PATH, Heidrun uses its own session, named heidrun, and
# stops it when you quit Heidrun, unless the setting "Keep agents running after
# quit" is on.
#
# When HERDR_SESSION or HERDR_SOCKET_PATH is set, Heidrun does not add the
# argument --session to the Herdr commands, and it never stops the session when
# you quit. An empty value is the same as no value.
#
# Default: heidrun
# Value: the name of a Herdr session.
###############################################################################
# HERDR_SESSION=my_session


###############################################################################
# HERDR_SOCKET_PATH
#
# The full path of the socket of the Herdr session that Heidrun uses. It has
# priority over HERDR_SESSION. The effect on the Herdr commands and on the stop
# at quit is the one that HERDR_SESSION describes. An empty value is the same
# as no value.
#
# Default: the file herdr.sock in the folder of the session, inside the folder
#          of the settings of Herdr.
# Value: the full path of a socket file.
###############################################################################
# HERDR_SOCKET_PATH=/tmp/herdr/herdr.sock


###############################################################################
# HERDR_BIN_PATH
#
# The full path of the program herdr. An application that the Finder starts does
# not get the PATH of your shell, so without this variable Heidrun looks in the
# usual places: ~/.local/bin, /opt/homebrew/bin, /usr/local/bin, and a few
# others. An empty value is the same as no value.
#
# Default: the first program herdr that Heidrun finds in the usual places.
# Value: the full path of the program herdr.
###############################################################################
# HERDR_BIN_PATH=/opt/homebrew/bin/herdr


###############################################################################
# XDG_CONFIG_HOME
#
# The folder of the settings of your programs. Heidrun reads the settings of
# Herdr in the folder herdr inside this folder, as Herdr does. An empty value is
# the same as no value.
#
# Default: ~/.config
# Value: the full path of a folder.
###############################################################################
# XDG_CONFIG_HOME=/tmp/xdg_config


###############################################################################
# SHELL
#
# The login shell that Heidrun uses to start the Herdr server in the
# background. macOS sets this variable for you, so change it only to test
# another shell.
#
# Default: the value that macOS sets, else /bin/zsh
# Value: the full path of a shell.
###############################################################################
# SHELL=/bin/zsh
